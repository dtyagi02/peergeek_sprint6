# Backend application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
PEERGEEK_AUTH_JWTSECRET=replace-with-a-local-only-secret-at-least-32-bytes
PEERGEEK_AUTH_ACCESSTOKENTTLSECONDS=900
PEERGEEK_AUTH_REFRESHTOKENTTLDAYS=14
PEERGEEK_AUTH_RESETOTPTTLMINUTES=10
PEERGEEK_AUTH_RESETOTPCOOLDOWNSECONDS=60
PEERGEEK_AUTH_REFRESHCOOKIESECURE=false

# Course authoring validation and technical safety caps
PEERGEEK_COURSE_MINIMUMTITLELENGTH=3
PEERGEEK_COURSE_MAXIMUMTITLELENGTH=120
PEERGEEK_COURSE_MAXIMUMDESCRIPTIONLENGTH=5000
PEERGEEK_COURSE_MAXIMUMTOPICS=10
PEERGEEK_COURSE_MINIMUMTOPICLENGTH=2
PEERGEEK_COURSE_MAXIMUMTOPICLENGTH=40
PEERGEEK_COURSE_MAXIMUMMODULETITLELENGTH=120
PEERGEEK_COURSE_MAXIMUMMODULEDESCRIPTIONLENGTH=1000
PEERGEEK_COURSE_MAXIMUMMODULESPERCOURSE=200
PEERGEEK_COURSE_MAXIMUMLESSONTITLELENGTH=150
PEERGEEK_COURSE_MAXIMUMLESSONSUMMARYLENGTH=500
PEERGEEK_COURSE_MAXIMUMLESSONSPERMODULE=500
PEERGEEK_COURSE_MAXIMUMCONTENTJSONBYTES=2097152
PEERGEEK_COURSE_MAXIMUMCONTENTDEPTH=20
PEERGEEK_BOOTSTRAP_ADMIN_EMAIL=
PEERGEEK_BOOTSTRAP_ADMIN_PASSWORD=
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
PEERGEEK_MAIL_FROM=no-reply@peergeek.local

# MySQL (peer-geek database is the source of truth)
MYSQL_DATABASE=peergeek
MYSQL_USER=peergeek
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-root-password
DB_HOST=mysql
DB_PORT=3306

# Redis (disposable cache)
REDIS_HOST=redis
REDIS_PORT=6379

# Local MinIO storage (use the AWS setup documented in README.md for real S3)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=peergeek
STORAGE_PATH_STYLE=true
STORAGE_CREATE_BUCKET_IF_MISSING=true

# Resource upload and processing limits
PEERGEEK_RESOURCES_MAXPDFBYTES=52428800
PEERGEEK_RESOURCES_MAXDOCUMENTBYTES=52428800
PEERGEEK_RESOURCES_MAXIMAGEBYTES=10485760
PEERGEEK_RESOURCES_MAXTHUMBNAILBYTES=5242880
PEERGEEK_RESOURCES_MAXVIDEOBYTES=1073741824
PEERGEEK_RESOURCES_MAXRESOURCESPERLESSON=50
PEERGEEK_RESOURCES_PUTURLTTL=15m
PEERGEEK_RESOURCES_GETURLTTL=5m
PEERGEEK_RESOURCES_ABANDONEDUPLOADAGE=24h
PEERGEEK_RESOURCES_DELETEDRESOURCEGRACE=1h
PEERGEEK_RESOURCES_STUCKPROCESSINGAGE=15m
PEERGEEK_RESOURCES_CLEANUPINTERVAL=15m
PEERGEEK_RESOURCES_MAXPROCESSINGATTEMPTS=3
PEERGEEK_RESOURCES_PROCESSINGTHREADS=2
PEERGEEK_RESOURCES_PROCESSINGQUEUECAPACITY=32
PEERGEEK_RESOURCES_MAXOOXMLEXPANDEDBYTES=67108864
PEERGEEK_RESOURCES_ALLOWEDPDFMIMETYPES=application/pdf
PEERGEEK_RESOURCES_ALLOWEDDOCUMENTMIMETYPES=application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv
PEERGEEK_RESOURCES_ALLOWEDIMAGEMIMETYPES=image/png,image/jpeg,image/webp,image/gif
PEERGEEK_RESOURCES_ALLOWEDVIDEOMIMETYPES=video/mp4,video/webm
PEERGEEK_RESOURCES_ALLOWEDPDFMAPPINGS=pdf=application/pdf
PEERGEEK_RESOURCES_ALLOWEDDOCUMENTMAPPINGS=docx=application/vnd.openxmlformats-officedocument.wordprocessingml.document,pptx=application/vnd.openxmlformats-officedocument.presentationml.presentation,xlsx=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,txt=text/plain,csv=text/csv
PEERGEEK_RESOURCES_ALLOWEDIMAGEMAPPINGS=png=image/png,jpg=image/jpeg,jpeg=image/jpeg,webp=image/webp,gif=image/gif
PEERGEEK_RESOURCES_ALLOWEDVIDEOMAPPINGS=mp4=video/mp4,webm=video/webm

# Phase 4 readiness, publishing and safe link checks
READINESS_REPORT_MAX_AGE=24h
READINESS_REPORT_MAX_ISSUES=500
READINESS_REPORT_COURSE_DESCRIPTION_WARNING_MIN_LENGTH=50
READINESS_RUNS_TIMEOUT=10m
READINESS_RUNS_COURSE_COOLDOWN=10s
READINESS_RUNS_MAX_CONCURRENT_PER_USER=3
READINESS_RUNS_THREADS=4
READINESS_RUNS_QUEUE_CAPACITY=32
READINESS_RUNS_RETENTION_PER_COURSE=10
READINESS_INTEGRITY_MAX_REHASH_BYTES=52428800
READINESS_VIDEO_PROBE_REQUIRED=true
READINESS_VIDEO_TIMEOUT=30s
READINESS_PDF_MAX_BYTES=52428800
READINESS_OOXML_MAX_ENTRIES=10000
READINESS_OOXML_MAX_EXPANDED_BYTES=67108864
READINESS_OOXML_MAX_COMPRESSION_RATIO=100
READINESS_IMAGE_MAX_PIXELS=50000000
READINESS_LINKS_CACHE_TTL=15m
READINESS_LINKS_ALLOW_PRIVATE_HOSTS=false
READINESS_LINKS_ALLOWED_PORTS=80,443
READINESS_LINKS_CONNECT_TIMEOUT=3s
READINESS_LINKS_TOTAL_TIMEOUT=8s
READINESS_LINKS_MAX_REDIRECTS=3
READINESS_LINKS_MAX_CONCURRENT=8
READINESS_LINKS_MAX_CONCURRENT_PER_HOST=2

# Phase 5 discovery, public preview, cache, and stats
DISCOVERY_DIRTY_FLUSH=5s
DISCOVERY_RECONCILE_INTERVAL=5m
DISCOVERY_MAX_OFFSET=1000
DISCOVERY_POPULAR_SIZE=12
DISCOVERY_STATS_MIN_COMPLETION_SAMPLE=10
DISCOVERY_CACHE_PREVIEW_TTL=10m
DISCOVERY_CACHE_POPULAR_TTL=2m
DISCOVERY_CACHE_CATEGORIES_TTL=10m

# Phase 7 assignments, assessments, and submission files
PEERGEEK_ASSIGNMENT_TIMER_GRACE_SECONDS=10
PEERGEEK_ASSIGNMENT_EXPIRY_CRON=0 * * * * *
PEERGEEK_ASSIGNMENT_FILES_MAX_FILES_PER_SUBMISSION=5
PEERGEEK_ASSIGNMENT_FILES_MAX_FILE_SIZE_BYTES=26214400
PEERGEEK_ASSIGNMENT_FILES_PRESIGNED_PUT_DURATION_MINUTES=15
PEERGEEK_ASSIGNMENT_FILES_PRESIGNED_GET_DURATION_MINUTES=15
PEERGEEK_ASSIGNMENT_CLEANUP_CRON=0 0 * * * *
PEERGEEK_ASSIGNMENT_CLEANUP_ABANDONED_THRESHOLD_HOURS=24

# Frontend API URL (used by the browser)
VITE_API_BASE_URL=http://localhost:8080/api/v1


# ==============================================================================
# Microservices Infrastructure Foundation (Phase 1)
# ==============================================================================

# API Gateway Configuration
GATEWAY_PORT=8081
MONOLITH_BASE_URL=http://localhost:8080
MONOLITH_WS_URL=ws://localhost:8080

# Apache Kafka (KRaft mode single-node event bus)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ADVERTISED_HOST=localhost

# RabbitMQ (Task queues and background processing)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=peergeek_dev
RABBITMQ_PASS=peergeek_pass

# Frontend Gateway Routing (Optional opt-in: set to http://localhost:8081 to route via Gateway)
VITE_GATEWAY_URL=http://localhost:8081

# ==============================================================================
# Notification Service (Phase 2)
# ==============================================================================
NOTIFICATION_PORT=8087
NOTIFICATION_SERVICE_URL=http://localhost:8087
